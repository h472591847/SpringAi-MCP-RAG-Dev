# ==========================================
# MCP Server 环境变量配置示例
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入你自己的真实配置信息
# ==========================================

# 邮箱配置
MAIL_USERNAME=你的邮箱
MAIL_PASSWORD=你的邮箱秘钥
MAIL_PORT=465
MAIL_HOST=你的邮箱服务器地址:例如smtp.qq.com

# 数据库配置 - 本地开发环境
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_HOST=localhost
MYSQL_PORT=3306

# 数据库配置 - 生产环境
MYSQL_USER_PROD=root
MYSQL_PASSWORD_PROD=your_mysql_prod_password_here
MYSQL_HOST_PROD=mysql
MYSQL_PORT_PROD=3306

